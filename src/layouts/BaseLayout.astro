---
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { Head } from '@michemayer/astro-components/components'
import ThemeProvider from '@components/providers/ThemeProvider.astro'
import type { Favicon } from '@michemayer/astro-components/models'
import * as styles from './BaseLayout.css.ts'
import { fontFaces } from '@/themes/font-faces.css'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/global.css'

interface Props {
  title: string
  description: string
  image?: string
}

const favicon: Favicon = {
  type: 'image/png',
  href: '/logos/band/favicon.png',
}

const { title, description, image = '/logos/band/full.png' } = Astro.props
---

<html lang="de">
  <Head
    title={title}
    description={description}
    image={image}
    favicon={[favicon]}
    fontFaces={fontFaces}
  />

  <body class:list={styles.wrapper}>
    <ThemeProvider>
      <Header classNames={styles.header} />
      <main>
        <slot />
      </main>
      <Footer />
    </ThemeProvider>
  </body>
</html>
