---
import * as styles from './IntroScreen.css'
import { Container, LayeredContentContainer } from '@michemayer/astro-components/components'
import type { DefaultComponentProps } from '@michemayer/astro-components/models'
import VideoSampleCard from './partials/VideoSampleCard.astro'
import EventQuickLink from './partials/EventQuickLink.astro'
import Logo from '@components/BandLogo.astro'

export type Props = DefaultComponentProps

const { id, classNames } = Astro.props as Props
---

<LayeredContentContainer
  id={id}
  class:list={[classNames]}
  isParallax={false}
>
  <video
    slot="background"
    class={styles.backgroundVideo}
    width="854"
    height="480"
    autoplay
    playsinline
    muted
    loop
  >
    <source src="/media/intro-cinematic.mp4" type="video/mp4" />
    <source src="/media/intro-cinematic.mov" type="video/mp4" />
    <source src="/media/intro-cinematic.mkv" type="video/mp4" />
    <img
      src="/media/intro-cinematic.png"
      alt="Your browser does not support video playback."
    />
  </video>
  <div class:list={[styles.fullscreen, styles.typography]}>
    <Logo classNames={styles.bandLogo} form="full" color="white" />
    <Container classNames={styles.introContent}>
      <VideoSampleCard videoUrl="https://youtu.be/CZODKM7GdSU" />
      <EventQuickLink classNames={styles.eventQuickLink} />
    </Container>
  </div>
</LayeredContentContainer>
