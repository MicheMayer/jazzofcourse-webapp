---
import type { DefaultComponentProps } from "@models/index"
import * as styles from "./BackgroundImage.css"
import BackgroundContentContainer from '@components/layout/BackgroundContentContainer.astro'
import { Image } from 'astro:assets'

interface Props extends DefaultComponentProps {
  src:
    | ImageMetadata
    | Promise<{
        default: ImageMetadata;
      }>;
  alt: string;
  imageFit?: 'contain' | 'cover';
}

const {
  id,
  classNames,
  src,
  alt,
  imageFit,
} = Astro.props
---

<BackgroundContentContainer id={id} classNames={[classNames]} isParallax={false}>
  <Image slot="background" class={styles.backgroundImage({ objectFit: imageFit })} src={src} alt={alt} width="1920" loading="lazy" />
  <slot />
</BackgroundContentContainer>
