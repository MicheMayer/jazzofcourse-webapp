---
import HeaderLink from '@components/HeaderLink.astro'
import BandLogo from '@components/BandLogo.astro'
import * as styles from './Header.css'
import SocialLink from '@components/navigation/socials/SocialLink.astro'
import type { DefaultComponentProps } from '@michemayer/astro-components/models'

interface Props extends DefaultComponentProps {
}

const { id, classNames } = Astro.props
---

<header id={id} class:list={[styles.bar, classNames]}>
  <nav class={styles.nav}>
    <a class={styles.logo} href="/#home">
      <BandLogo classNames={styles.bandIcon} form="j" color="black" />
    </a>
    <div class={styles.internalLinks}>
      <HeaderLink href="/#events">Auftritte</HeaderLink>
      <HeaderLink href="/#booking">Buchung</HeaderLink>
    </div>
    <div class={styles.externalLinks}>
      <SocialLink type="instagram" label="Instagram" minifyAt='md' />
      <SocialLink type="facebook" label="Facebook" minifyAt='md' />
      <SocialLink type="youtube" label="Youtube" minifyAt='md' />
    </div>
  </nav>
</header>