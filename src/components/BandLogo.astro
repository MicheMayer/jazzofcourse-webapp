---
import type { DefaultComponentProps } from '@michemayer/astro-components/models'
import * as styles from './BandLogo.css'
import type { LogoColor, Form } from './BandLogo.css'
import { Image } from 'astro:assets'


export type Props = DefaultComponentProps & {
  form: Form
  color: LogoColor
  imageMask?: ImageMetadata
}

const { id, classNames, form, color, imageMask } = Astro.props as Props
---

<div id={id} class:list={[styles.mask({ form, color }), classNames]}>
  {imageMask && <Image src={imageMask} alt="Jazz of course" />}
</div>
