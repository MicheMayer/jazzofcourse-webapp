---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import { slugify } from '@michemayer/astro-components/utils'
import Post from '@components/content/posts/Post.astro'

export async function getStaticPaths() {
  const posts = await getCollection('posts')

  return posts.map((post) => ({
    params: {
      slug:
        post.data.slug ??
        slugify(post.data.title, post.data.created.toLocaleDateString()),
      category: post.data.category,
    },
    props: post,
  }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props as Props

// this fixes the issue of vanilla-extract not rendering within mdx files by preloading each component
import.meta.glob(`@components/*.astro`)
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Post post={post} />
</BaseLayout>
