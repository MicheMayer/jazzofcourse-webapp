---
import { SITE_TITLE, SITE_DESCRIPTION } from 'src/consts'
import BusinessCard from '@components/content/business-card/BusinessCard.astro'
import { Container } from '@michemayer/astro-components/components'
import { Head } from '@michemayer/astro-components/components'
import ThemeProvider from '@components/providers/ThemeProvider.astro'
import type { Favicon } from '@michemayer/astro-components/models'
import { fontFaces } from '@/themes/font-faces.css'

// Import the global.css file here so that it is included on
import '@/global.css'

const favicon: Favicon = {
  type: 'image/png',
  href: '/logos/band/favicon.png',
}
---

<html lang="de">
  <Head
    title={SITE_TITLE}
    description={SITE_DESCRIPTION}
    image="/logos/band/full.png"
  favicon={[favicon]},
    fontFaces={fontFaces}

  />
  <body>
    <main>
      <ThemeProvider>
        <Container>
          <BusinessCard id="lets-see-paul-allens-card" />
        </Container>
      </ThemeProvider>
    </main>
  </body>
</html>
