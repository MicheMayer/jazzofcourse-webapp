---
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts'
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import { slugify } from '@michemayer/astro-components/utils'
import EventPost from '@components/content/events/EventPost.astro'

export async function getStaticPaths() {
  const posts = await getCollection('events')
  return posts.map((post) => ({
    params: {
      slug: slugify(post.data.title, post.data.date.toLocaleDateString()),
    },
    props: post,
  }))
}
type Props = CollectionEntry<'events'>

// this fixes the issue of vanilla-extract not rendering within mdx files by preloading each component
import.meta.glob(`@components/*.astro`)
const post = Astro.props
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image={post.data.heroImage?.src}
  title={post.data.title}
  description={post.data.description}
>
  <EventPost post={post} />
</BaseLayout>
